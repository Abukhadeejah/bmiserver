generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Member {
  id                 Int      @id @default(autoincrement())
  memberId           String   @unique
  name               String
  phone              String
  email              String?
  dateOfBirth        DateTime?
  relationshipStatus String?
  serviceLooking     String?  // "Member", "Personal Training", etc.
  platform           String?  // "Member", "Online", etc.
  customerType       String   @default("new") // "new", "existing", "returning"
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  bmiRecords    BMIRecord[]
  notifications Notification[]
}

model BMIRecord {
  id                   Int      @id @default(autoincrement())
  memberId             Int
  
  // Basic measurements
  height               Float    // in cm
  weight               Float    // in kg
  bmi                  Float
  category             String
  
  // Extended health metrics (matching PDF template)
  age                  Int?
  idealBodyWeight      Float?   // kg
  totalFatPercentage   Float?   // %
  subcutaneousFat      Float?   // %
  visceralFat          Float?   // level
  muscleMass           Float?   // kg
  restingMetabolism    Int?     // calories
  biologicalAge        Int?     // years
  
  // Report details
  healthConclusion     String?  // "Avoid outside food", etc.
  recordedAt           DateTime @default(now())
  attendedBy           String?
  
  member        Member @relation(fields: [memberId], references: [id])
  notifications Notification[]
}

model Notification {
  id             Int      @id @default(autoincrement())
  memberId       Int
  bmiRecordId    Int
  whatsappSent   Boolean  @default(false)
  emailSent      Boolean  @default(false)
  whatsappStatus String?
  emailStatus    String?
  sentAt         DateTime @default(now())
  
  member    Member    @relation(fields: [memberId], references: [id])
  bmiRecord BMIRecord @relation(fields: [bmiRecordId], references: [id])
}

model AdminUser {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
  role         String @default("admin")
  createdAt    DateTime @default(now())
}

model UserPass {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  password     String
  role         String   // "admin" or "staff"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
